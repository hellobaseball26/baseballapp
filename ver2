          <div class="onlineUse"><div><b>온라인 예매 시 쿠폰 코드 입력</b><small>예매 페이지의 할인/쿠폰 코드 입력란에 아래 코드를 입력하세요.</small></div><div class="useCode">OUTFIELD-1FREE-8A7F</div><button class="codeCopy" onclick="copyCoupon()">코드 복사</button></div><div class="mission"><div class="missionLine"><div class="missionIcon">1</div><div class="missionText"><b>쿠폰 저장</b><small>내 쿠폰함에 보관합니다.</small></div></div></div><div class="mission"><div class="missionLine"><div class="missionIcon">2</div><div class="missionText"><b>다음 홈경기 방문</b><small>온라인 예매 시 결제 단계에서 쿠폰 코드를 입력합니다.</small></div></div></div><div class="mission"><div class="missionLine"><div class="missionIcon">3</div><div class="missionText"><b>외야지정석 1회 무료</b><small>사용 완료 후 쿠폰 상태가 소진으로 변경됩니다.</small></div></div></div>
        <button class="cta" style="width:100%;padding:14px" onclick="toast('쿠폰이 내 쿠폰함에 저장되었습니다!')">쿠폰 저장하기</button></div>
      </section>
    </div>

    <nav class="nav">
      <button id="n-home" class="active" onclick="go('home')"><i>⌂</i>홈</button>
      <button id="n-map" onclick="go('map')"><i>⌖</i>지도</button>
      <button id="n-hot" onclick="go('hot')"><i>★</i>핫플</button>
      <button id="n-mission" onclick="go('mission')"><i>◎</i>미션</button>
      <button id="n-ticket" onclick="go('ticket')"><i>🎫</i>티켓</button>
    </nav>
    <div id="toast" class="toast"></div>
    <div id="modal" class="modal"><div class="sheet"><h2 id="modalTitle">미션 인증</h2><p id="modalText">관광지 방문 인증을 완료하면 스탬프가 지급됩니다.</p><button onclick="confirmModal()">인증 완료하기</button></div></div>
  </main>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
let current='home', completed=[false,false,false,false], pending=0;

function mapToast(msg){ toast(msg); }
function copyCoupon(){
  navigator.clipboard?.writeText('OUTFIELD-1FREE-8A7F');
  toast('쿠폰 코드가 복사되었습니다!');
}

function go(id){
  document.querySelectorAll('.screenView').forEach(x=>x.classList.remove('active'));
  document.getElementById(id).classList.add('active'); current=id;
  document.querySelectorAll('.nav button').forEach(x=>x.classList.remove('active'));
  const n=document.getElementById('n-'+id); if(n)n.classList.add('active');
  document.querySelector('.screen').scrollTop=0;
}
function openMission(){go('mission'); toast('스탬프 투어가 시작되었습니다!');}
function completeMission(n){
  if(completed[n-1]){ if(n===4)go('ticket'); return; }
  pending=n;
  const names=['창원(1루)','마산(2루)','진해(3루)','NC파크'];
  document.getElementById('modalTitle').textContent=names[n-1]+' 미션 인증';
  document.getElementById('modalText').textContent=n===4?'NC파크로 돌아오면 투어 완료! 다음 홈경기 티켓을 받을 수 있어요.':'현장 방문 후 인증 코드를 입력해 스탬프를 획득하세요.';
  document.getElementById('modal').classList.add('show');
}
function confirmModal(){
  completed[pending-1]=true; document.getElementById('modal').classList.remove('show');
  const ids=['m1','m2','m3','m4']; const stamps=['s1','s2','s3','sh'];
  document.getElementById(ids[pending-1]).classList.add('done');
  const btn=document.querySelector('#'+ids[pending-1]+' .missionBtn'); btn.textContent='✓ 완료'; btn.classList.add('done');
  if(pending<=3) document.getElementById(stamps[pending-1]).classList.add('on');
  const count=completed.filter(Boolean).length;
  document.getElementById('progressBar').style.width=(count*25)+'%';
  document.getElementById('mapProgress').textContent=count+' / 4';
  toast(pending===4?'🎫 투어 완료! 다음 홈경기 티켓이 발급되었습니다.':'⚾ 스탬프 획득! 다음 루로 이동해보세요.');
  if(pending===4)setTimeout(()=>go('ticket'),700);
}
function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');clearTimeout(window.tt);window.tt=setTimeout(()=>t.classList.remove('show'),2200)}

function verifyCode(n){
  const expected={1:'1234',2:'2345',3:'3456',4:'4567'}[n];
  const input=document.getElementById('code'+n);
  if(!input || input.value.trim()!==expected){
    toast('인증코드가 맞지 않아요. 현장 아르바이트생에게 코드를 확인해주세요.');
    return;
  }
  completed[n-1]=true;
  const ids=['m1','m2','m3','m4']; const stamps=['s1','s2','s3','sh'];
  document.getElementById(ids[n-1]).classList.add('done');
  const btn=document.querySelector('#'+ids[n-1]+' .codeRow button'); if(btn){btn.textContent='✓ 완료';btn.disabled=true}
  if(n<=3) document.getElementById(stamps[n-1]).classList.add('on');
  const count=completed.filter(Boolean).length;
  document.getElementById('progressBar').style.width=(count*25)+'%';
  document.getElementById('mapProgress').textContent=count+' / 4';
  toast(n===4?'🎫 투어 완료! 외야지정석 1회 무료 쿠폰이 발급되었습니다.':'⚾ 스탬프 획득! 다음 루로 이동해보세요.');
  if(n===4)setTimeout(()=>go('ticket'),700);
}
function previewPhoto(input,id){
  const img=document.getElementById(id); const file=input.files && input.files[0];
  if(!file)return;
  img.src=URL.createObjectURL(file); img.hidden=false;
  toast('사진이 첨부되었습니다. 이제 현장 인증코드를 입력하세요.');
}
function openReview(place){
  pendingReview=place;
  document.getElementById('modalTitle').textContent=place+' 후기/제보';
  document.getElementById('modalText').innerHTML='<textarea id="reviewText" placeholder="지금 이곳의 분위기, 날씨, 혼잡도, 한줄 후기를 남겨주세요." style="width:100%;height:90px;border:1px solid #dbe5ed;border-radius:12px;padding:10px;font:inherit;resize:none"></textarea><div style="margin-top:8px;font-size:11px;color:#71849a">예: “비가 그쳤고 10분 정도 기다리면 사진 찍기 좋아요.”</div>';
  document.querySelector('#modal .sheet button').textContent='후기 등록하기';
  document.getElementById('modal').classList.add('show');
}
let pendingReview='';
const oldConfirmModal=confirmModal;
confirmModal=function(){
  if(pendingReview){
    const text=document.getElementById('reviewText')?.value.trim();
    document.getElementById('modal').classList.remove('show');
    document.querySelector('#modal .sheet button').textContent='인증 완료하기';
    toast(text?'후기가 등록되었습니다! 다른 여행자에게 공유돼요.':'한줄 제보창을 닫았습니다.');
    pendingReview='';
    return;
  }
  oldConfirmModal();
}

function postTip(slug, place){
 const input=document.getElementById('input-'+slug), text=input?.value.trim();
 if(!text){toast('한줄 제보 내용을 입력해주세요.');return;}
 const list=document.getElementById('posts-'+slug), item=document.createElement('div');
 item.className='communityPost'; const who=document.createElement('b');who.textContent='방문자 · 방금 전';
 const p=document.createElement('p');p.textContent='“'+text+'”';item.appendChild(who);item.appendChild(p);list.prepend(item);input.value='';
 toast(place+' 제보톡에 등록되었습니다!');
}

function claimCoupon(name){toast(name+' 우천취소 쿠폰이 발급되었습니다! 내 쿠폰에서 확인하세요.')}

</script>
</body>
</html>
